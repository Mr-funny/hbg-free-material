# Add only the providers you want to use. Never commit your real .env file.
PEXELS_API_KEY=your_pexels_api_key
UNSPLASH_API_KEY=your_unsplash_access_key
PIXABAY_API_KEY=your_pixabay_api_key

HBG_MATERIAL_DOWNLOAD_DIR=./downloads
HBG_MATERIAL_CONNECT_TIMEOUT=10
HBG_MATERIAL_READ_TIMEOUT=120
HBG_MATERIAL_MAX_IMAGE_MB=100
HBG_MATERIAL_MAX_VIDEO_MB=500
HBG_MATERIAL_MAX_AUDIO_MB=250

# Optional localhost-only Pixabay audio range proxy.
HBG_MATERIAL_PROXY_HOST=127.0.0.1
HBG_MATERIAL_PROXY_PORT=8765
HBG_MATERIAL_PROXY_PUBLIC_BASE=http://127.0.0.1:8765
HBG_MATERIAL_PROXY_MAX_MB=250
